def a_star(graph, h, start, goal): 
    open_list = [start] 
    closed = set() 
    g = {start: 0} 
    parent = {start: start} 
 
    while open_list: 
        n = min(open_list, key=lambda node: g[node] + h[node]) 
 
        if n == goal: 
            path = [] 
            while parent[n] != n: 
                path.append(n) 
                n = parent[n] 
            path.append(start) 
            path.reverse() 
 
            print("Path:", path) 
            print("Cost:", g[goal]) 
            return path, g[goal] 
 
        open_list.remove(n) 
        closed.add(n) 
 
        for m, cost in graph[n].items(): 
            new_cost = g[n] + cost 
 
            if m not in g or new_cost < g[m]: 
                g[m] = new_cost 
                parent[m] = n 
 
                if m in closed: 
                    closed.remove(m) 
 
                if m not in open_list: 
                    open_list.append(m) 
 
    print("Path not found") 
    return None, float("inf") 
 
 
